{
  "name": "@wess2001/reaper",
  "version": "0.1.1",
  "description": "Deterministic data access security analysis for TypeScript and PostgreSQL",
  "type": "module",
  "bin": {
    "reaper": "bin/reaper.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pg": "8.16.3",
    "pgsql-ast-parser": "12.0.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.15.6",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript-eslint": "8.48.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WessYu/REAPER.git"
  }
}
