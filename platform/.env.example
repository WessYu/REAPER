# Administrative commands only
REAPER_PLATFORM_ADMIN_DATABASE_URL=postgres://platform_admin:change-me@127.0.0.1:5432/reaper

# API or worker runtime database URL: use separate LOGIN users with least-privilege group roles
REAPER_PLATFORM_DATABASE_URL=postgres://reaper_runtime:change-me@127.0.0.1:5432/reaper
REAPER_PLATFORM_API_KEY_PEPPER=replace-with-at-least-32-random-characters

# API
REAPER_PLATFORM_HOST=127.0.0.1
REAPER_PLATFORM_PORT=7338

# Worker / signing service
REAPER_PLATFORM_SIGNER_URL=https://signer.example.internal/v1/sign
REAPER_PLATFORM_SIGNER_TOKEN=replace-from-secret-manager
REAPER_PLATFORM_SCOPE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
REAPER_PLATFORM_RUNNER_IMAGE=reaper-platform-runner:local
REAPER_PLATFORM_DOCKER_NETWORK=reaper-assessment-egress
REAPER_PLATFORM_CONFIG_ROOT=/srv/reaper/config
REAPER_PLATFORM_STATE_ROOT=/srv/reaper/state
REAPER_PLATFORM_OUTPUT_ROOT=/srv/reaper/output
REAPER_PLATFORM_WORKER_ID=worker-01
REAPER_PLATFORM_CONTAINER_UID=65532:65532
